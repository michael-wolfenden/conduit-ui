{
  "name": "conduit-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/*",
    "#realworld-submodule/*": "./realworld/*"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "update-deps": "pnpm up -i --latest && pnpm dedupe",
    "format": "oxfmt",
    "check": "npm-run-all --parallel --continue-on-error --print-summary-table --print-label check:*",
    "check:format": "oxfmt --check",
    "check:oxlint": "oxlint",
    "check:knip": "knip",
    "prepare": "lefthook install",
    "test": "vitest --run",
    "test:ui": "vitest  --ui",
    "test:e2e": "cross-env VITE_ENABLE_MOCKS=false playwright test",
    "test:e2e:ui": "pnpm test:e2e --ui --ui-port=0",
    "refresh-submodule": "git submodule deinit -f --all && git submodule update --init --remote --recursive",
    "initialize": "git submodule update --init --recursive && pnpm install && lefthook install"
  },
  "dependencies": {
    "@better-fetch/fetch": "1.3.2",
    "@casl/ability": "7.0.1",
    "@tanstack/markdown": "1.0.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-form-devtools": "0.2.34",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-devtools": "1.167.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-top-loading-bar": "3.0.2",
    "spin-delay": "2.0.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@standard-config/oxlint": "2.10.0",
    "@standard-config/oxlint-react": "2.10.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/router-plugin": "1.168.43",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/ui": "5.0.3",
    "cross-env": "10.1.0",
    "eslint-plugin-zod": "5.0.0",
    "factory.ts": "1.4.2",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "msw": "3.0.3",
    "npm-run-all-next": "1.4.2",
    "oxc-transform-react": "0.153.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
